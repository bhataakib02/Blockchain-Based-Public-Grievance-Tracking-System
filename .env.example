# ------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database direct connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:your-password@db.your-supabase-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------
# Backend Security (JWT)
# ------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-signing-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# Blockchain & Ethereum RPC Node
# ------------------------------------------------------------
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# ------------------------------------------------------------
# Frontend Environment Variables (Vite prefixed)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

VITE_CHAIN_ID=31337
